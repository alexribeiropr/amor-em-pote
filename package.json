  "type": "module",
  "scripts": {
    "dev": "concurrently -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"yellow.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "dev:client": "vite",
    "server": "node server/index.js",
